# CONST-053 — .gitignore + No-Versioned-Build-Artifacts Mandate

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o
*.class
*.pyc

# Build / output trees
/bin/
/build/
/dist/
/out/
target/

# Test binary + coverage artefacts (regenerable via `make test-coverage`)
*.test
*.out
coverage.out
coverage.html
cover.html
cover.out
htmlcov/

# Cache files
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.next/
.cache/
.gradle/
.terraform/

# Temp files
*.tmp
*.swp
*.swo
*~
*.orig
*.rej

# Go workspace
go.work
go.work.sum

# IDE / personal state
.idea/
.history/
.vscode/

# OS
.DS_Store
Thumbs.db

# Sensitive-data files (CONST-042 secret-leak intersection)
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
.netrc
secrets/
api_keys.sh

# Generated reports / logs
*.log
